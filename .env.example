# Claude API key (or run `ant auth login` on the server instead)
ANTHROPIC_API_KEY=

# Dashboard. With no password set, the dashboard only listens on 127.0.0.1.
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=

# Where settings, credentials, notes, logs and benchmark results are kept.
DATA_DIR=./data

# Browser (3D) client mode: path to Chrome/Chromium. Leave blank to use the one puppeteer downloaded.
CHROME_PATH=

# The SDK prefers the demo server's direct gateway port and falls back to the relay if it stalls.
# Set to false to skip the direct port entirely.
# GATEWAY_DIRECT=false
